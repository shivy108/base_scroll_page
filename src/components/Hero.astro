---
---

<section id="hero" class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Canvas particle network -->
  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full opacity-40"></canvas>

  <!-- Scan line -->
  <div class="scan-line"></div>

  <!-- Dot grid overlay -->
  <div class="absolute inset-0 opacity-[0.04] dot-grid"></div>

  <!-- Mesh gradient -->
  <div class="absolute inset-0 opacity-20 mesh-gradient" style="filter: blur(100px);"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6">
    <p id="hero-label" class="hero-label text-text-muted text-sm uppercase tracking-[0.3em] mb-6 font-mono" style="opacity: 0;">
      <span id="typewriter-text"></span><span style="border-right: 2px solid #a855f7; animation: typewriter-cursor 0.8s step-end infinite;">&nbsp;</span>
    </p>

    <div class="relative inline-block">
      <h1 class="hero-title font-display leading-none mb-8" style="font-size: clamp(3.5rem, 9vw, 9rem); opacity: 0;">
        <span class="text-text-primary">shiv</span><span class="gradient-text">.</span><span class="gradient-text">rocks</span>
      </h1>
      <!-- Glitch layers -->
      <h1 class="font-display leading-none mb-8 absolute inset-0 pointer-events-none select-none" style="font-size: clamp(3.5rem, 9vw, 9rem); animation: glitch 8s infinite; color: #06b6d4;" aria-hidden="true">
        <span>shiv</span><span>.</span><span>rocks</span>
      </h1>
      <h1 class="font-display leading-none mb-8 absolute inset-0 pointer-events-none select-none" style="font-size: clamp(3.5rem, 9vw, 9rem); animation: glitch 8s infinite 0.08s; color: #ec4899;" aria-hidden="true">
        <span>shiv</span><span>.</span><span>rocks</span>
      </h1>
    </div>

    <!-- Slogan -->
    <p class="hero-slogan font-mono text-xs uppercase tracking-[0.5em] mb-6 opacity-0" style="color: #a855f7;">
      Engineering Tomorrow, Today
    </p>

    <p class="hero-subtitle text-text-secondary font-heading font-light max-w-2xl mx-auto mb-14" style="font-size: clamp(1.05rem, 1.8vw, 1.35rem); opacity: 0;">
      A precision software studio. We take on selected clients and build things that last — native iOS, AI integration, and full-stack systems engineered to perform.
    </p>

    <!-- CTA buttons -->
    <div class="hero-cta flex flex-col sm:flex-row gap-4 justify-center" style="opacity: 0;">
      <a href="#projects" class="group relative px-8 py-4 overflow-hidden rounded-xl" data-magnetic="0.2">
        <span class="absolute inset-0 bg-gradient-to-r from-accent-1 via-accent-3 to-accent-4 transition-transform duration-500 group-hover:scale-105"></span>
        <span class="relative font-heading font-semibold text-white text-sm tracking-wide">View Our Work</span>
      </a>
      <a href="#contact" class="glass px-8 py-4 rounded-xl font-heading font-medium text-text-primary text-sm tracking-wide hover:bg-white/10 transition-colors duration-300" data-magnetic="0.2">
        Start a Project
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div id="scroll-indicator" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3" style="opacity: 0;">
    <span class="text-text-muted text-xs uppercase tracking-[0.2em] font-mono">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-accent-2 to-transparent animate-pulse"></div>
  </div>
</section>

<script>
  // Typewriter effect
  const phrases = [
    'Bespoke Software · Mobile · AI',
    'Built for the few. Engineered to last.',
    'Selected clients. Exceptional results.',
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const el = document.getElementById('typewriter-text');
  const label = document.getElementById('hero-label');

  function typeWrite() {
    if (!el) return;
    const current = phrases[phraseIndex];
    if (isDeleting) {
      el.textContent = current.substring(0, charIndex - 1);
      charIndex--;
    } else {
      el.textContent = current.substring(0, charIndex + 1);
      charIndex++;
    }
    let delay = isDeleting ? 40 : 80;
    if (!isDeleting && charIndex === current.length) {
      delay = 2500;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      delay = 300;
    }
    setTimeout(typeWrite, delay);
  }

  setTimeout(() => {
    if (label) label.style.opacity = '1';
    typeWrite();
  }, 800);

  // Particle network canvas
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let W = (canvas.width = window.innerWidth);
    let H = (canvas.height = window.innerHeight);
    let mouseX = W / 2;
    let mouseY = H / 2;

    window.addEventListener('resize', () => {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    });

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    const PARTICLE_COUNT = 70;
    const MAX_DIST = 140;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      colorIndex: number;
    }

    const colors = ['#6366f1', '#a855f7', '#ec4899', '#06b6d4'];

    const particles: Particle[] = Array.from({ length: PARTICLE_COUNT }, (_, i) => ({
      x: Math.random() * W,
      y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.4,
      radius: Math.random() * 1.5 + 0.5,
      colorIndex: i % colors.length,
    }));

    function drawParticles() {
      ctx.clearRect(0, 0, W, H);
      const mp = { x: mouseX, y: mouseY };

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > W) p.vx *= -1;
        if (p.y < 0 || p.y > H) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = colors[p.colorIndex];
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DIST) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = 'rgba(168,85,247,' + ((1 - dist / MAX_DIST) * 0.25) + ')';
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }

        const mdx = p.x - mp.x;
        const mdy = p.y - mp.y;
        const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
        if (mdist < MAX_DIST * 1.5) {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(mp.x, mp.y);
          ctx.strokeStyle = 'rgba(99,102,241,' + ((1 - mdist / (MAX_DIST * 1.5)) * 0.4) + ')';
          ctx.lineWidth = 0.6;
          ctx.stroke();
        }
      }

      requestAnimationFrame(drawParticles);
    }

    drawParticles();
  }
</script>
