---
const year = new Date().getFullYear();
---

<footer class="relative py-12 px-6 border-t border-white/5">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Logo -->
    <a href="#" class="font-heading text-lg font-bold tracking-wider">
      <span class="text-text-primary">shiv</span><span class="gradient-text text-xl">.</span><span class="gradient-text">rocks</span>
    </a>

    <!-- Copyright -->
    <p class="text-text-muted text-sm font-mono">
      &copy; {year} Shivesh Dindayal
    </p>

    <!-- Back to top -->
    <button
      id="back-to-top"
      class="glass px-4 py-2 rounded-lg text-text-secondary text-sm hover:text-text-primary hover:bg-white/10 transition-all duration-300"
      data-magnetic="0.2"
      aria-label="Back to top"
    >
      &uarr; Top
    </button>
  </div>
</footer>

<script>
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
