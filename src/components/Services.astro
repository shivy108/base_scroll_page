---
const services = [
  {
    title: 'Mobile Development',
    description: 'Native iOS and React Native apps built for scale. From fintech to consumer — shipped to millions of users.',
    tags: ['React Native', 'Swift', 'SwiftUI', 'iOS', 'Android'],
    icon: 'phone',
    accent: '#6366f1',
  },
  {
    title: 'AI Integration',
    description: 'Embedding intelligent features into mobile and web products. LLMs, on-device ML, and smart automation.',
    tags: ['LLMs', 'On-Device ML', 'AI Agents', 'Automation'],
    icon: 'sparkle',
    accent: '#a855f7',
  },
  {
    title: 'Full-Stack Solutions',
    description: 'End-to-end architecture from APIs to infrastructure. Crypto trading systems, real-time backends, and cloud deployments.',
    tags: ['Node.js', 'Python', 'Solana', 'AWS', 'Docker'],
    icon: 'layers',
    accent: '#ec4899',
  },
];

const stats = [
  { value: 10, suffix: '+', label: 'Years Experience' },
  { value: 50, suffix: '+', label: 'Apps Shipped' },
  { value: 3, suffix: '', label: 'Chains Supported' },
  { value: 100, suffix: 'M+', label: 'Users Reached' },
];
---

<section id="services" class="relative py-24 md:py-40 px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Section header -->
    <div class="section-header mb-16 md:mb-20 text-center">
      <p class="text-accent-2 text-sm uppercase tracking-[0.3em] mb-4 font-mono">What We Do</p>
      <h2 class="font-heading font-bold" style="font-size: clamp(2rem, 4vw, 3.5rem);">
        Core <span class="gradient-text">Expertise</span>
      </h2>
    </div>

    <!-- Stats row -->
    <div class="stats-row grid grid-cols-2 md:grid-cols-4 gap-6 mb-20">
      {stats.map((stat) => (
        <div class="text-center p-6 glass rounded-2xl">
          <div
            class="font-display text-4xl md:text-5xl gradient-text mb-1"
            style="font-variant-numeric: tabular-nums;"
            data-target={stat.value}
            data-suffix={stat.suffix}
          >
            0{stat.suffix}
          </div>
          <div class="text-text-muted text-xs font-mono uppercase tracking-wider">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Service cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div
          class="service-card glow-border glass rounded-2xl p-8 md:p-10 transition-all duration-500 hover:shadow-2xl group overflow-hidden relative"
          data-index={i}
        >
          <!-- Shimmer sweep on hover -->
          <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-2xl">
            <div class="shimmer-sweep absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              style="background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.06) 50%, transparent 65%); transform: translateX(-100%);">
            </div>
          </div>

          <!-- Icon with float animation -->
          <div
            class="w-14 h-14 rounded-xl flex items-center justify-center mb-6"
            style={"background: " + service.accent + "20; animation: float 4s ease-in-out infinite; animation-delay: " + (i * 0.5) + "s;"}
          >
            {service.icon === 'phone' && (
              <svg class="w-7 h-7" style={"color: " + service.accent + ";"} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
            )}
            {service.icon === 'sparkle' && (
              <svg class="w-7 h-7" style={"color: " + service.accent + ";"} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
              </svg>
            )}
            {service.icon === 'layers' && (
              <svg class="w-7 h-7" style={"color: " + service.accent + ";"} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
            )}
          </div>

          <h3 class="font-heading font-bold text-xl mb-3 text-text-primary">{service.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-6">{service.description}</p>

          <div class="flex flex-wrap gap-2">
            {service.tags.map((tag) => (
              <span class="px-2.5 py-1 text-[11px] font-mono bg-white/5 rounded-md border border-white/10 text-text-secondary">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Animated counter
  function animateCounter(el: HTMLElement, target: number, suffix: string) {
    const duration = 2000;
    const start = performance.now();
    const update = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }

  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0');
          const suffix = el.dataset.suffix || '';
          animateCounter(el, target, suffix);
          counterObserver.unobserve(el);
        }
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll('[data-target]').forEach((el) => counterObserver.observe(el));

  // Shimmer sweep on hover
  document.querySelectorAll('.service-card').forEach((card) => {
    const sweep = card.querySelector('.shimmer-sweep') as HTMLElement;
    if (!sweep) return;
    card.addEventListener('mouseenter', () => {
      sweep.style.transform = 'translateX(-100%)';
      sweep.style.transition = 'none';
      requestAnimationFrame(() => {
        sweep.style.transition = 'transform 0.6s ease';
        sweep.style.transform = 'translateX(200%)';
      });
    });
  });
</script>
