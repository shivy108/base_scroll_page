---
const pillars = [
  {
    label: 'Mobile-first',
    title: 'Built for the device in your pocket',
    description: 'We start with mobile because that\'s where your users are. Native iOS and Android — not wrapped web apps — means performance that feels instant and interfaces that feel right.',
    accent: '#6366f1',
    icon: 'phone',
    link: '#capabilities',
    cta: 'See mobile work →',
  },
  {
    label: 'AI-native',
    title: 'Intelligence wired in from day one',
    description: 'Not a chatbot bolted on after launch. We architect AI into the core of your product — agents that act, models that learn, and automation that compounds over time.',
    accent: '#a855f7',
    icon: 'sparkle',
    link: '#capabilities',
    cta: 'See AI demos →',
  },
  {
    label: 'Full-stack',
    title: 'One team. Zero handoff friction.',
    description: 'From Rust core to cloud infrastructure, we own the whole stack. No agency handoffs, no finger-pointing. One team accountable for everything that ships.',
    accent: '#ec4899',
    icon: 'layers',
    link: '#contact',
    cta: 'Start a project →',
  },
];
---

<section id="services" class="relative py-24 md:py-32 px-6 overflow-hidden">
  <!-- Subtle divider line top -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-transparent to-white/10"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Section header -->
    <div class="section-header mb-4 text-center">
      <p class="text-accent-2 text-sm uppercase tracking-[0.3em] mb-4 font-mono">Our Approach</p>
      <h2 class="font-heading font-bold mb-4" style="font-size: clamp(2rem, 4vw, 3.5rem);">
        <span class="scramble" data-text="Why">Why</span> <span class="scramble gradient-text" data-text="shiv.rocks">shiv.rocks</span>
      </h2>
      <p class="text-text-secondary font-heading font-light max-w-xl mx-auto mb-16" style="font-size: clamp(0.95rem, 1.4vw, 1.1rem);">
        We don't take every project. We take the right ones — and we build them properly.
      </p>
    </div>

    <!-- Three pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      {pillars.map((p, i) => (
        <div
          class="service-card glow-border glass rounded-2xl p-8 md:p-10 transition-all duration-500 hover:shadow-2xl group overflow-hidden relative flex flex-col"
          data-index={i}
        >
          <!-- Shimmer sweep -->
          <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-2xl">
            <div class="shimmer-sweep absolute inset-0 opacity-0 group-hover:opacity-100"
              style="background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.05) 50%, transparent 65%); transform: translateX(-100%); transition: none;">
            </div>
          </div>

          <!-- Top: label pill + icon -->
          <div class="flex items-start justify-between mb-8">
            <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full border"
              style={"color: " + p.accent + "; border-color: " + p.accent + "30; background: " + p.accent + "10;"}>
              {p.label}
            </span>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center"
              style={"background: " + p.accent + "15; animation: float 4s ease-in-out infinite; animation-delay: " + (i * 0.6) + "s;"}>
              {p.icon === 'phone' && (
                <svg class="w-6 h-6" style={"color: " + p.accent + ";"} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
              )}
              {p.icon === 'sparkle' && (
                <svg class="w-6 h-6" style={"color: " + p.accent + ";"} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                </svg>
              )}
              {p.icon === 'layers' && (
                <svg class="w-6 h-6" style={"color: " + p.accent + ";"} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
              )}
            </div>
          </div>

          <!-- Content -->
          <h3 class="font-heading font-bold text-xl mb-3 text-text-primary leading-snug">{p.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-6 flex-1">{p.description}</p>

          <!-- CTA link -->
          <a href={p.link}
            class="inline-flex items-center gap-2 text-xs font-mono transition-all duration-300 group-hover:gap-3"
            style={"color: " + p.accent + ";"}>
            {p.cta}
          </a>

          <!-- Bottom accent line -->
          <div class="absolute bottom-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style={"background: linear-gradient(90deg, transparent, " + p.accent + "60, transparent);"}>
          </div>
        </div>
      ))}
    </div>

    <!-- Separator with "scroll to see what we build" -->
    <div class="flex items-center gap-6 justify-center">
      <div class="h-px flex-1 bg-gradient-to-r from-transparent to-white/10"></div>
      <a href="#capabilities" class="flex items-center gap-2 text-text-muted text-xs font-mono uppercase tracking-wider hover:text-text-secondary transition-colors duration-300 group">
        <span>See what we build</span>
        <svg class="w-3 h-3 group-hover:translate-y-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
        </svg>
      </a>
      <div class="h-px flex-1 bg-gradient-to-l from-transparent to-white/10"></div>
    </div>
  </div>
</section>

<script>
  // Shimmer sweep on hover
  document.querySelectorAll('.service-card').forEach((card) => {
    const sweep = card.querySelector('.shimmer-sweep') as HTMLElement;
    if (!sweep) return;
    card.addEventListener('mouseenter', () => {
      sweep.style.transform = 'translateX(-100%)';
      sweep.style.transition = 'none';
      requestAnimationFrame(() => {
        sweep.style.transition = 'transform 0.6s ease';
        sweep.style.transform = 'translateX(200%)';
      });
    });
  });
</script>
