<script>
  // ---- AI Chat Demo ----
  const chatConversation = [
    { role: 'user', text: 'Summarise last week\'s sales' },
    { role: 'ai',   text: 'Revenue up 24% vs prior week. Top SKU: Pro Plan. 3 churns detected.' },
    { role: 'user', text: 'Why did those users churn?' },
    { role: 'ai',   text: 'Analysing patterns... Likely cause: onboarding drop-off at step 3.' },
    { role: 'user', text: 'Suggest a fix' },
    { role: 'ai',   text: 'Add a contextual tooltip on step 3. I\'ve drafted the copy ✓' },
  ];

  function initChatDemo(container: HTMLElement) {
    const msgBox = container.querySelector('.chat-messages') as HTMLElement;
    if (!msgBox) return;
    msgBox.innerHTML = '';
    let i = 0;

    function addMessage() {
      if (i >= chatConversation.length) {
        setTimeout(() => {
          msgBox.innerHTML = '';
          i = 0;
          addMessage();
        }, 3000);
        return;
      }
      const msg = chatConversation[i];
      const wrap = document.createElement('div');
      wrap.className = 'flex ' + (msg.role === 'user' ? 'justify-end' : 'justify-start');
      const bubble = document.createElement('div');
      bubble.className = msg.role === 'user'
        ? 'max-w-[75%] px-2.5 py-1.5 rounded-xl rounded-tr-sm text-[9px] font-mono bg-accent-2/20 text-accent-2 border border-accent-2/20'
        : 'max-w-[80%] px-2.5 py-1.5 rounded-xl rounded-tl-sm text-[9px] font-mono bg-white/5 text-text-secondary border border-white/8';

      // Typing dots for AI
      if (msg.role === 'ai') {
        bubble.innerHTML = '<span class="inline-flex gap-0.5"><span class="w-1 h-1 rounded-full bg-text-muted animate-bounce" style="animation-delay:0s"></span><span class="w-1 h-1 rounded-full bg-text-muted animate-bounce" style="animation-delay:0.15s"></span><span class="w-1 h-1 rounded-full bg-text-muted animate-bounce" style="animation-delay:0.3s"></span></span>';
        wrap.appendChild(bubble);
        msgBox.appendChild(wrap);
        msgBox.scrollTop = msgBox.scrollHeight;
        setTimeout(() => {
          bubble.textContent = msg.text;
          msgBox.scrollTop = msgBox.scrollHeight;
          i++;
          setTimeout(addMessage, 1200);
        }, 900);
      } else {
        bubble.textContent = msg.text;
        wrap.appendChild(bubble);
        msgBox.appendChild(wrap);
        msgBox.scrollTop = msgBox.scrollHeight;
        i++;
        setTimeout(addMessage, 600);
      }
    }
    addMessage();
  }

  // ---- Agents Demo — animated data packets ----
  function initAgentsDemo(container: HTMLElement) {
    const svg = container.querySelector('#agent-lines') as SVGElement;
    if (!svg) return;
    const rect = container.getBoundingClientRect();
    const W = rect.width || 300;
    const H = rect.height || 176;

    // Center node
    const center = { x: W / 2, y: H / 2 };
    const subs = [
      { x: W * 0.18, y: H * 0.18 },
      { x: W * 0.82, y: H * 0.18 },
      { x: W * 0.18, y: H * 0.82 },
      { x: W * 0.82, y: H * 0.82 },
    ];
    const colors = ['#6366f1', '#ec4899', '#22c55e', '#eab308'];

    // Draw static lines
    svg.innerHTML = subs.map((s, i) =>
      `<line x1="${center.x}" y1="${center.y}" x2="${s.x}" y2="${s.y}" stroke="${colors[i]}" stroke-width="0.5" stroke-opacity="0.25" stroke-dasharray="3 3"/>`
    ).join('');

    // Animate packets
    let active = 0;
    function spawnPacket() {
      const sub = subs[active % subs.length];
      const color = colors[active % colors.length];
      const toCenter = active % 2 === 0;
      const start = toCenter ? sub : center;
      const end   = toCenter ? center : sub;

      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('r', '3');
      circle.setAttribute('fill', color);
      circle.setAttribute('cx', String(start.x));
      circle.setAttribute('cy', String(start.y));
      svg.appendChild(circle);

      const dur = 800;
      const startTime = performance.now();
      function animate(now: number) {
        const t = Math.min((now - startTime) / dur, 1);
        const ease = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
        circle.setAttribute('cx', String(start.x + (end.x - start.x) * ease));
        circle.setAttribute('cy', String(start.y + (end.y - start.y) * ease));
        circle.setAttribute('opacity', String(1 - t * 0.3));
        if (t < 1) requestAnimationFrame(animate);
        else circle.remove();
      }
      requestAnimationFrame(animate);
      active++;
    }

    const interval = setInterval(spawnPacket, 400);
    // Store cleanup ref
    (container as any)._agentInterval = interval;
  }

  // ---- E-commerce Demo ----
  function initEcommDemo(container: HTMLElement) {
    const status = container.querySelector('.ecomm-status') as HTMLElement;
    const cart = container.querySelector('.ecomm-cart') as HTMLElement;
    if (!status || !cart) return;

    const messages = [
      'Checkout with ETH or SOL',
      'Connecting wallet...',
      'Payment confirmed ✓',
      'Order processing...',
      'Shipped! Track on-chain ✓',
    ];
    let count = 3;
    let idx = 0;

    const cycle = setInterval(() => {
      idx = (idx + 1) % messages.length;
      status.style.opacity = '0';
      setTimeout(() => {
        status.textContent = messages[idx];
        status.style.opacity = '1';
        if (idx === 2) {
          count++;
          cart.textContent = String(count);
          cart.style.color = '#22c55e';
          setTimeout(() => { cart.style.color = ''; }, 600);
        }
        if (idx === messages.length - 1) { count = 3; cart.textContent = '3'; }
      }, 300);
    }, 1800);

    (container as any)._ecommInterval = cycle;
  }

  // ---- Intersection observer to start demos ----
  const demoObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const card = entry.target as HTMLElement;
      const chatEl = card.querySelector('#demo-ai-chat') as HTMLElement;
      const agentEl = card.querySelector('#demo-agents') as HTMLElement;
      const ecommEl = card.querySelector('#demo-ecomm') as HTMLElement;
      if (chatEl) initChatDemo(chatEl);
      if (agentEl) setTimeout(() => initAgentsDemo(agentEl), 300);
      if (ecommEl) initEcommDemo(ecommEl);
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.cap-card').forEach((c) => demoObserver.observe(c));
</script>

<style>
  .ecomm-status { transition: opacity 0.3s; }
  .demo-area { will-change: transform; }
</style>
