<header id="site-header" class="fixed top-0 left-0 w-full z-50">
  <div class="relative mx-auto max-w-7xl px-6 py-5 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="font-heading text-xl font-bold tracking-wider" data-magnetic="0.2">
      <span class="text-text-primary">shiv</span><span class="gradient-text text-2xl">.</span><span class="gradient-text text-lg">rocks</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="#services"
        class="text-text-secondary hover:text-text-primary text-sm uppercase tracking-[0.2em] transition-colors duration-300"
      >
        Services
      </a>
      <a
        href="#projects"
        class="text-text-secondary hover:text-text-primary text-sm uppercase tracking-[0.2em] transition-colors duration-300"
      >
        Work
      </a>
      <a
        href="#contact"
        class="text-text-secondary hover:text-text-primary text-sm uppercase tracking-[0.2em] transition-colors duration-300"
