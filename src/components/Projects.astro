---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section id="projects" class="relative py-24 md:py-0">
  <div class="max-w-7xl mx-auto px-6 md:px-0">
    <!-- Section header — visible above the horizontal scroll on desktop -->
    <div class="section-header mb-12 md:mb-0 md:absolute md:top-24 md:left-1/2 md:-translate-x-1/2 md:z-10 text-center md:w-full">
      <p class="text-accent-2 text-sm uppercase tracking-[0.3em] mb-4 font-mono">Track Record</p>
      <h2 class="font-heading font-bold" style="font-size: clamp(2rem, 4vw, 3.5rem);">
        <span class="scramble" data-text="Featured">Featured</span> <span class="scramble gradient-text" data-text="Work">Work</span>
      </h2>
    </div>
  </div>

  <!-- Horizontal scroll container (desktop) -->
  <div id="h-scroll-outer" class="hidden md:block relative" style="height: 500vh;">
    <div id="h-scroll-inner" class="sticky top-0 h-screen flex items-center overflow-hidden">
      <div id="h-scroll-track" class="flex gap-8 pl-[20vw] pr-[20vw] will-change-transform">
        {projects.map((project, i) => (
          <div class="shrink-0 w-[420px]">
            <ProjectCard project={project} index={i} />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Vertical stack (mobile) -->
  <div class="md:hidden px-6 grid grid-cols-1 gap-6">
    {projects.map((project, i) => (
      <ProjectCard project={project} index={i} />
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const outer = document.getElementById('h-scroll-outer');
  const track = document.getElementById('h-scroll-track');

  if (outer && track) {
    const totalWidth = track.scrollWidth - window.innerWidth;

    gsap.to(track, {
      x: -totalWidth,
      ease: 'none',
      scrollTrigger: {
        trigger: outer,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1,
        pin: false,
        invalidateOnRefresh: true,
      },
    });
  }
</script>
