---
---

<section id="contact" class="relative py-24 md:py-40 px-6 overflow-hidden">
  <!-- Mesh gradient background -->
  <div class="absolute inset-0 opacity-20 mesh-gradient" style="filter: blur(120px);"></div>

  <div id="contact-content" class="relative z-10 max-w-4xl mx-auto text-center">
    <p class="text-accent-2 text-sm uppercase tracking-[0.3em] mb-4 font-mono">Contact</p>

    <h2 class="font-display leading-none mb-8" style="font-size: clamp(3rem, 8vw, 7rem);">
      Let's build<br>something <span class="gradient-text">great</span>
    </h2>

    <p class="text-text-secondary font-heading font-light mb-16 max-w-lg mx-auto" style="font-size: clamp(1rem, 1.5vw, 1.25rem);">
      We work with a small number of clients at a time. If you have a serious project, reach out — we'll tell you if we're the right fit.
    </p>

    <!-- Contact cards -->
    <div class="flex flex-col sm:flex-row gap-5 justify-center">
      <a
        href="mailto:info@shiv.rocks"
        class="contact-card glass-strong group px-8 py-6 rounded-2xl flex items-center gap-4 hover:border-accent-6/30 transition-all duration-300"
        data-magnetic="0.15"
      >
        <svg class="w-6 h-6 text-accent-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
        <div class="text-left">
          <p class="text-text-muted text-xs font-mono uppercase tracking-wider">Email</p>
          <p class="text-text-primary text-sm font-heading group-hover:text-accent-6 transition-colors">info@shiv.rocks</p>
        </div>
      </a>

      <a
        href="https://www.linkedin.com/in/shivesh-dindayal-25291a111/"
        target="_blank"
        rel="noreferrer"
        class="contact-card glass-strong group px-8 py-6 rounded-2xl flex items-center gap-4 hover:border-accent-1/30 transition-all duration-300"
        data-magnetic="0.15"
      >
        <svg class="w-6 h-6 text-accent-1 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
        <div class="text-left">
          <p class="text-text-muted text-xs font-mono uppercase tracking-wider">LinkedIn</p>
          <p class="text-text-primary text-sm font-heading group-hover:text-accent-1 transition-colors">Shivesh Dindayal</p>
        </div>
      </a>

      <a
        href="https://github.com/shivy108"
        target="_blank"
        rel="noreferrer"
        class="contact-card glass-strong group px-8 py-6 rounded-2xl flex items-center gap-4 hover:border-accent-3/30 transition-all duration-300"
        data-magnetic="0.15"
      >
        <svg class="w-6 h-6 text-accent-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        <div class="text-left">
          <p class="text-text-muted text-xs font-mono uppercase tracking-wider">GitHub</p>
          <p class="text-text-primary text-sm font-heading group-hover:text-accent-3 transition-colors">shivy108</p>
        </div>
      </a>
    </div>
  </div>
</section>
